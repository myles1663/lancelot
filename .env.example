# Lancelot configuration template
# Copy this file to `.env` for manual installs.
# Secrets shown here are placeholders only. Do not commit your real `.env`.

# ------------------------------------------------------------
# Provider selection
# ------------------------------------------------------------
LANCELOT_PROVIDER=gemini
LANCELOT_PROVIDER_MODE=sdk

# Configure at least one provider key matching your chosen provider.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# NVIDIA_API_KEY=

# ------------------------------------------------------------
# Security tokens
# ------------------------------------------------------------
# Onboarding or the installer can generate these automatically if omitted.
# For production, set them explicitly and store them securely.
LANCELOT_OWNER_TOKEN=
LANCELOT_API_TOKEN=
LANCELOT_VAULT_KEY=
# Development-only escape hatch. Do not enable in production.
# LANCELOT_ALLOW_EPHEMERAL_VAULT=false
# HOST_AGENT_TOKEN=

# ------------------------------------------------------------
# War Room authentication
# ------------------------------------------------------------
# Choose exactly one auth provider.
LANCELOT_AUTH_PROVIDER=local

# Local auth
# Set explicit local-operator credentials if using local auth.
# No default admin account is provisioned.
WARROOM_USERNAME=
WARROOM_PASSWORD=
WARROOM_PASSWORD_RESET_CODE=

# OIDC auth
# LANCELOT_AUTH_PROVIDER=oidc
# OIDC_ISSUER_URL=https://your-idp.example.com/realms/lancelot
# OIDC_CLIENT_ID=lancelot-war-room
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
# OIDC_ALLOWED_GROUPS=lancelot-admins,lancelot-operators
# OIDC_ALLOW_ANY_AUTHENTICATED=false
# Set OIDC_ALLOW_ANY_AUTHENTICATED=true only when you intentionally want any
# authenticated OIDC user to reach the War Room.

# ------------------------------------------------------------
# Local model runtime
# ------------------------------------------------------------
LOCAL_LLM_URL=http://local-llm:8080
LOCAL_MODEL_PROFILE=qwen3-8b
LOCAL_LLM_ENGINE=llama_cpp_python
LOCAL_LLM_MODEL=local-llm
LOCAL_MODEL_CTX=4096
LOCAL_MODEL_THREADS=4
LOCAL_MODEL_GPU_LAYERS=0
# Safe default. Set to cu123 only when the host has a stable CUDA path.
LOCAL_LLM_DOCKERFILE=Dockerfile
LOCAL_LLM_WHEEL_VARIANT=cpu
LOCAL_LLM_WHEEL_VERSION=0.3.19
LOCAL_LLM_HEALTH_START_PERIOD=900s
# Prism Bonsai runtime. Leave these unset unless you intentionally run the
# Bonsai profile or build the optional Bonsai services with COMPOSE_PROFILES.
# Dockerfile.prism is CPU-only and intended for portable smoke tests.
# Dockerfile.prism.cuda is the production container path for GPU-backed Bonsai.
# COMPOSE_PROFILES=bonsai
# BONSAI_LLM_DOCKERFILE=Dockerfile.prism.cuda
# PRISM_CUDA_BASE_IMAGE=nvidia/cuda:12.3.2-devel-ubuntu22.04
# PRISM_LLAMA_CPP_REF=d104cf1b639a909ddea521d61f7cb023c6e41f57
# PRISM_CMAKE_ARGS=-DGGML_CUDA=ON
# PRISM_CUDA_ARCHITECTURES=
# PRISM_BUILD_JOBS=2
# LOCAL_LLM_DOCKERFILE=Dockerfile.prism.cuda
# LOCAL_MODEL_PROFILE=bonsai-8b
# LOCAL_LLM_ENGINE=prism_llama_server
# PRISM_RELEASE_TAG=prism-b8846-d104cf1
# PRISM_RELEASE_ASSET=llama-prism-b8846-d104cf1-bin-ubuntu-x64.tar.gz
# PRISM_RELEASE_SHA256=80bb9a820bb61389dc9f34c976f00afc33018d199b8ae81dd1afeaad2044ec87
LANCELOT_LOCAL_EXECUTION_MODE=low_risk_only
LANCELOT_FRONTIER_SCRUB_MODE=required

# Optional role-specific local model routing.
# Leave unset to use LOCAL_LLM_URL for every role.
# Target split deployment: Bonsai 1.7B region finder, Bonsai 8B segment
# verifier + utility. Ternary Bonsai 8B remains available as an opt-in profile
# after host-specific latency validation.
# LOCAL_LLM_BONSAI_1_7B_URL=http://local-bonsai-17b:8080
# LOCAL_LLM_BONSAI_8B_URL=http://local-bonsai-8b:8080
# LOCAL_LLM_SCRUB_REGION_FINDER_URL=http://local-bonsai-17b:8080
# LOCAL_LLM_SCRUB_SEGMENT_VERIFIER_URL=http://local-bonsai-8b:8080
# LOCAL_LLM_UTILITY_URL=http://local-bonsai-8b:8080
# LOCAL_LLM_MODEL=local-llm
# LOCAL_LLM_SCRUB_REGION_FINDER_MODEL=bonsai-1.7b
# LOCAL_LLM_SCRUB_SEGMENT_VERIFIER_MODEL=bonsai-8b
# LOCAL_LLM_UTILITY_MODEL=bonsai-8b
# LANCELOT_FRONTIER_SCRUB_CASCADE_ENABLED=true
# LANCELOT_FRONTIER_SCRUB_CASCADE_MIN_CHARS=6000
# LANCELOT_SCRUB_REGION_FINDER_TIMEOUT_S=8
# LANCELOT_SCRUB_REGION_FINDER_MAX_CHARS=6000
# LANCELOT_SCRUB_REGION_FINDER_MAX_CHUNKS=8
# LANCELOT_SCRUB_SEGMENT_VERIFIER_TIMEOUT_S=10
# LANCELOT_LOCAL_UTILITY_TIMEOUT_S=30

# ------------------------------------------------------------
# Communications
# ------------------------------------------------------------
LANCELOT_COMMS_TYPE=none
# LANCELOT_TELEGRAM_TOKEN=
# LANCELOT_TELEGRAM_CHAT_ID=
# LANCELOT_TELEGRAM_DEBUG_DUMP=false
# LANCELOT_CHAT_SPACE_NAME=
# LANCELOT_COMMS_WEBHOOK=
LANCELOT_WEBHOOK_AUTH_MODE=google_signed
# Required in google_signed mode:
# LANCELOT_GOOGLE_CHAT_AUDIENCE=
# Required in bonded_bearer mode:
# LANCELOT_WEBHOOK_BEARER=

# ------------------------------------------------------------
# Deployment / ops metadata
# ------------------------------------------------------------
# Prebuilt core runtime image. Pin to a released tag or digest for production.
LANCELOT_CORE_IMAGE=ghcr.io/myles1663/lancelot:latest
LANCELOT_LOG_LEVEL=INFO
LANCELOT_OPERATOR_NAME=operator
# LANCELOT_DEPLOYMENT_ID=
# LANCELOT_ENV=production
# LANCELOT_DATA_DIR=/home/lancelot/data
# LANCELOT_CHAT_RUN_STALE_AFTER_S=3600
# LANCELOT_WORKSPACE=/home/lancelot/workspace
# Bind mounts used by the installer so host-written bootstrap files are visible
# inside the container. Unset these to use the named-volume defaults in compose.
LANCELOT_DATA_MOUNT=./lancelot_data
LANCELOT_WORKSPACE_MOUNT=./lancelot_workspace

# ------------------------------------------------------------
# Feature flags (common baseline)
# ------------------------------------------------------------
FEATURE_SOUL=true
FEATURE_SKILLS=true
FEATURE_HEALTH_MONITOR=true
FEATURE_SCHEDULER=true
FEATURE_TOOLS_FABRIC=true
FEATURE_RISK_TIERED_GOVERNANCE=true
