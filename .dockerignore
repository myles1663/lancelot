# Model weights (mounted as volume, not baked into image)
local_models/weights/

# Runtime data must never be baked into public images. Clean bootstrap
# templates live under config/bootstrap and are seeded by the app when a
# fresh data volume starts.
/data/
/lancelot_data/
/secrets/
coverage.xml
coverage*.json
*.log

# Git
.git/

# Local runtime configuration and generated artifacts
.env
.env.*
!.env.example
local/
artifacts/
audit_*.log
.coverage
.pytest_cache/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Tests (not needed in production image)
tests/

# Installer (npm package, not needed in Docker image)
installer/

# Frontend dependency/build outputs are recreated inside Docker
src/warroom/node_modules/
src/warroom/dist/

# Docs
docs/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
